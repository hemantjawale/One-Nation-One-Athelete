PORT=4000
MONGODB_URI=
JWT_SECRET=
APP_ORIGIN=http://localhost:5173
# Blank MongoDB URI enables a local persistent development database.
# In production set NODE_ENV=production and a long random JWT_SECRET.

# Cloudinary Certificate Storage (Backend only - never expose secret to client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sunday Email Digest SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="One Nation One Athlete" <noreply@onenationoneathlete.org>

# External Sports Data Providers (Optional - Backend only)
SPORTS_API_URL=
SPORTS_API_KEY=
ATHLETICS_API_URL=
ATHLETICS_API_KEY=
BADMINTON_API_URL=
BADMINTON_API_KEY=
